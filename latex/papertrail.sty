% papertrail.sty -- number-level provenance for manuscripts
% Usage:  \usepackage{papertrail}   then   \ptval{acc_test}  or  \ptval[1]{acc_test}
% Values come from papertrail-values.tex, generated by:  papertrail macros > papertrail-values.tex
% Option [links] makes each value a PDF link whose target names the run ID.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{papertrail}[2026/11/23 v0.1 number-level provenance]
\RequirePackage{xfp}
\newif\ifpt@links \pt@linksfalse
\DeclareOption{links}{\pt@linkstrue}
\ProcessOptions\relax
\newcommand{\ptdef}[3]{%
  \expandafter\def\csname pt@v@#1\endcsname{#2}%
  \expandafter\def\csname pt@r@#1\endcsname{#3}}
\newcommand{\ptval}[2][2]{%
  \@ifundefined{pt@v@#2}{\textbf{??#2??}\PackageWarning{papertrail}{Unknown key #2}}{%
    \ifpt@links
      \href{papertrail:#2@\csname pt@r@#2\endcsname}{\fpeval{round(\csname pt@v@#2\endcsname,#1)}}%
    \else
      \fpeval{round(\csname pt@v@#2\endcsname,#1)}%
    \fi}}
\newcommand{\ptpct}[2][1]{\ptval[#1]{#2}}% for values already stored in percent
\InputIfFileExists{papertrail-values.tex}{}{\PackageWarning{papertrail}{papertrail-values.tex not found}}
\endinput
